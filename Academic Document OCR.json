            },
            {
              "name": "content_retrieval",
              "description": "Retrieve the most relevant sections, passages, or information from the uploaded document to answer the user's question. Use the source document as the primary source and do not invent information that is not present in it."
            },
            {
              "name": "summarization",
              "description": "Summarize the relevant content from the uploaded document when the user asks for a summary of a page, section, chapter, topic, or passage."
            },
            {
              "name": "location_retrieval",
              "description": "Identify where relevant information appears in the uploaded document when the user asks which page, section, chapter, or part of the document contains a specific topic or concept."
            },
            {
              "name": "question_answering",
              "description": "Answer questions using information retrieved from the uploaded textbook, research paper, or academic document. Ground the response in the available source material and avoid unsupported information."
